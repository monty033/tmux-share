#!/usr/bin/env bash
# tmux-share-selftest: a disposable end-to-end run of the transcript tap on a
# scratch tmux server. Everything it creates (socket, session, transcript,
# lock, markers) lives in one temp directory that is removed on every exit
# path. It never reads or writes a deployment path.
#
# CHECKS (reported through core/lib/checks.sh, in this order)
#   deps-present                 every program the run needs is on PATH
#   temp-dir-outside-deployment  the temp dir is not inside TMUX_SHARE_DIR,
#                                and its socket path fits the kernel limit
#   scratch-server-starts        a tmux server on the temp socket runs SESSION
#   tap-start-attaches           tmux-share-tap-start leaves pane_pipe at 1
#   output-reaches-transcript    a marker typed into the pane lands in the
#                                transcript on a timestamped line (5 s bound)
#   watchdog-idempotent          a second watchdog pass exits 0 and pane_pipe
#                                stays 1
#   deletion-recovery            after the transcript is deleted, the watchdog
#                                writes the rebuild marker during its pass,
#                                clears it afterwards, and new output is
#                                captured
#   trimming                     a transcript over the bound is cut to it, the
#                                newest bytes survive, the taps are re-attached
#                                and new output is still captured
#   verifier-clean               tmux-share-verify exits 0 with no FAIL, and
#                                its reader check reports SKIP, not PASS
#   cleanup-no-leftover-process  no process still names the scratch socket
#   cleanup-temp-dir-removed     the temp dir is gone (not checked with --keep)
#
# USAGE
#   tmux-share-selftest [--keep]     --keep leaves the temp dir and prints it
#
# ENVIRONMENT
#   The self-test reads these itself:
#     TMUX_SHARE_TMUX      tmux binary for the scratch server (default: tmux)
#     TMUX_SHARE_TIMEOUT   timeout binary (default: timeout)
#     TMUX_SHARE_STAMP     stamp program under test (default: core/tmux-share-stamp)
#     TMUX_SHARE_DIR       deployment directory the temp dir must not enter
#                          (default: /run/tmux-share)
#     TMPDIR               where the temp dir is made (default: /tmp)
#   Every other TMUX_SHARE_* variable is set explicitly for the scripts under
#   test, so a leaked value cannot point them at a stub or a deployment.
#
# NOTES
#   * The scratch server starts under `env -i` with `-f /dev/null`, so the
#     operator's tmux configuration and sessions are never used.
#   * umask 027 is set, so the server, the transcript and the rebuilt
#     transcript are 0640, as on a deployment.
#   * verifier-clean runs the verifier as the invoking account with
#     TMUX_SHARE_VERIFY_OWNER set to that account, so owner checks compare
#     against it, not root:root. Its reader check (5) reports SKIP because
#     the invoking account owns the scratch socket, and being permitted to
#     connect to your own socket says nothing about a reader.
#   * The verifier scans a script directory for a live pipe-pane -o. It is
#     given a copy of the three runtime scripts (tap-start, watchdog, trim),
#     not all of core/bin, because tmux-share-preflight calls -o on purpose
#     to probe the toggle.
#   * The rebuild pass runs behind a small wrapper around tmux, so the rebuild
#     marker can be seen while the pass is still running.
#
# Exit status: 0 only if every check passed; 1 otherwise; 2 for bad usage.
set -eu
umask 027
LC_ALL=C          # socket path limits are in bytes
export LC_ALL

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
CORE_DIR=$(CDPATH= cd -- "$HERE/.." && pwd)
BIN_DIR=$HERE
LIB_DIR=$CORE_DIR/lib

# shellcheck source=../lib/checks.sh
. "$LIB_DIR/checks.sh"

TMUX_BIN=${TMUX_SHARE_TMUX:-tmux}
TIMEOUT_BIN=${TMUX_SHARE_TIMEOUT:-timeout}
STAMP=${TMUX_SHARE_STAMP:-$CORE_DIR/tmux-share-stamp}
DEPLOY_DIR=${TMUX_SHARE_DIR:-/run/tmux-share}
SOCK_LIMIT=107    # sun_path is 108 bytes including the terminating NUL
MAX_BYTES=4096    # trim bound for the run; the fixture is four times this
SESSION="selftest-$$"
KEEP=0

case ${1:-} in
    '') ;;
    --keep) KEEP=1 ;;
    -h | --help)
        sed -n '2,/^set -eu$/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
        exit 0
        ;;
    *)
        printf 'tmux-share-selftest: unexpected argument %s (usage: tmux-share-selftest [--keep])\n' "$1" >&2
        exit 2
        ;;
esac
if [ "$#" -gt 1 ]; then
    printf 'tmux-share-selftest: too many arguments (usage: tmux-share-selftest [--keep])\n' >&2
    exit 2
fi

# ---- run state -------------------------------------------------------------
T=''                 # temp dir; everything else lives under it
SOCK=''
LOG=''
LOCK=''
REBUILD=''
SEEN=''              # written by the rebuild wrapper while the pass runs
WRAP=''
PANE=''
SERVER_UP=0
FINISHED=0
RC=0
GROUP=''
OWNER=''
CHILD_ENV=()

# ---- helpers ---------------------------------------------------------------
# first_line FILE: the first line of FILE, printable, at most 200 bytes.
first_line() {
    head -n 1 -- "$1" 2>/dev/null | tr -cd '[:print:]' | cut -c 1-200
}

# inside PATH DIR: 0 if PATH is DIR or lies below it (both already resolved).
inside() {
    case $1 in
        "$2" | "$2"/*) return 0 ;;
    esac
    return 1
}

# scratch_tmux ARGS...: the tmux client on the scratch socket, bounded, under a
# cleared environment.
scratch_tmux() {
    env -i PATH="$PATH" "$TIMEOUT_BIN" 10 "$TMUX_BIN" -S "$SOCK" "$@" </dev/null
}

# need_server: 0 if the scratch server was started; otherwise record a
# failure for the open check.
need_server() {
    if [ "$SERVER_UP" -eq 1 ]; then
        return 0
    fi
    check_fail 'the scratch server is not running'
    return 1
}

# pane_pipe PANE: the pane's #{pane_pipe}, or MISSING / ERROR.
pane_pipe() {
    local out p v
    if ! out=$(scratch_tmux list-panes -s -t "$SESSION" -F '#{pane_id} #{pane_pipe}' 2>/dev/null); then
        printf 'ERROR'
        return 0
    fi
    while IFS=' ' read -r p v; do
        if [ "$p" = "$1" ]; then
            printf '%s' "$v"
            return 0
        fi
    done <<EOF
$out
EOF
    printf 'MISSING'
}

# first_pane: the id of the session's first pane.
first_pane() {
    scratch_tmux list-panes -s -t "$SESSION" -F '#{pane_id}' 2>/dev/null \
        | awk 'NR == 1 { print $1; exit }'
}

# send_marker TOKEN: type "echo TOKEN" into the pane, then press Enter.
send_marker() {
    scratch_tmux send-keys -t "$PANE" -l "echo $1" \
        && scratch_tmux send-keys -t "$PANE" Enter
}

# stamped_marker TOKEN: 0 if the transcript has a timestamped line with TOKEN.
stamped_marker() {
    [ -f "$LOG" ] || return 1
    tr -d '\r' < "$LOG" \
        | grep -aqE "^\[[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}\] .*$1"
}

# wait_for_marker TOKEN: poll for up to 5 s for a timestamped line with TOKEN.
wait_for_marker() {
    local i=0
    while ! stamped_marker "$1"; do
        i=$((i + 1))
        if [ "$i" -gt 50 ]; then
            return 1
        fi
        sleep 0.1
    done
}

# socket_procs: the pids whose command line names the scratch socket. Read
# with bash only, so this script's own grep or tr cannot match itself.
socket_procs() {
    local d cmd
    for d in /proc/[0-9]*; do
        cmd=$(tr '\0' ' ' 2>/dev/null < "$d/cmdline") || continue
        case $cmd in
            *"$SOCK"*) printf '%s\n' "${d#/proc/}" ;;
        esac
    done
    return 0
}

# kill_server: ask the scratch server to exit. The outcome is checked later.
kill_server() {
    if [ -n "$SOCK" ]; then
        scratch_tmux kill-server >/dev/null 2>&1 || true
    fi
}

# set_child_env: every contract variable, set explicitly for the scripts.
set_child_env() {
    CHILD_ENV=(
        "PATH=$PATH"
        "LC_ALL=C"
        "TMPDIR=${TMPDIR:-/tmp}"
        "TMUX_SHARE_DIR=$T"
        "TMUX_SHARE_SESSION=$SESSION"
        "TMUX_SHARE_SOCK=$SOCK"
        "TMUX_SHARE_LOG=$LOG"
        "TMUX_SHARE_LOCK=$LOCK"
        "TMUX_SHARE_NOTREADY_MARKER=$T/.notready-since"
        "TMUX_SHARE_REBUILD=$REBUILD"
        "TMUX_SHARE_STAMP=$STAMP"
        "TMUX_SHARE_TMUX=$TMUX_BIN"
        "TMUX_SHARE_TIMEOUT=$TIMEOUT_BIN"
        "TMUX_SHARE_MAX_BYTES=$MAX_BYTES"
        "TMUX_SHARE_LIBDIR=$LIB_DIR"
    )
}

# run_child TAG COMMAND...: run COMMAND under the contract environment and
# nothing inherited. Sets RC; the output goes to $T/TAG.out.
run_child() {
    local tag=$1
    shift
    RC=0
    env -i "${CHILD_ENV[@]}" "$@" </dev/null >"$T/$tag.out" 2>&1 || RC=$?
}

# ---- 1. dependencies and the temp dir -------------------------------------------
step_deps() {
    local dep missing=''
    check_begin deps-present
    for dep in "$TMUX_BIN" "$TIMEOUT_BIN" flock python3 realpath mktemp awk \
            chmod chown cp grep head mv sleep stat tail tr cut wc od env; do
        if ! command -v "$dep" >/dev/null 2>&1; then
            missing="$missing $dep"
        fi
    done
    if [ -n "$missing" ]; then
        check_fail "not found on PATH:$missing"
        return 1
    fi
    TMUX_BIN=$(command -v "$TMUX_BIN")
    TIMEOUT_BIN=$(command -v "$TIMEOUT_BIN")
    STAMP=$(realpath -m -- "$STAMP")
    check_pass
}

step_tempdir() {
    local base deploy resolved
    check_begin temp-dir-outside-deployment
    deploy=$(realpath -m -- "$DEPLOY_DIR")
    base=$(realpath -m -- "${TMPDIR:-/tmp}")
    if inside "$base" "$deploy"; then
        check_fail "TMPDIR $base is inside the deployment directory $deploy; not creating the temp dir there"
        return 1
    fi
    if ! T=$(mktemp -d "${TMPDIR:-/tmp}/tmux-share-selftest.XXXXXX"); then
        T=''
        check_fail 'cannot create the temp dir'
        return 1
    fi
    resolved=$(realpath -- "$T")
    if inside "$resolved" "$deploy"; then
        check_fail "temp dir $resolved is inside the deployment directory $deploy; refusing"
        rm -rf -- "$T"
        T=''
        return 1
    fi
    SOCK=$T/tmux.sock
    if [ "${#SOCK}" -gt "$SOCK_LIMIT" ]; then
        check_fail "socket path is ${#SOCK} bytes; the kernel limit is $SOCK_LIMIT"
        rm -rf -- "$T"
        T=''
        SOCK=''
        return 1
    fi
    chmod 0750 -- "$T"
    LOG=$T/transcript.log
    LOCK=$T/tap.lock
    REBUILD=$T/.rebuild-required
    SEEN=$T/rebuild-seen
    WRAP=$T/tmux-wrap
    GROUP=$(id -gn)
    OWNER=$(id -un):$GROUP
    check_pass
}

# ---- 2. scratch server and the first tap -----------------------------------
step_server() {
    check_begin scratch-server-starts
    if ! scratch_tmux -f /dev/null new-session -d -s "$SESSION" -x 120 -y 30 'exec cat' \
            >"$T/server.out" 2>"$T/server.err"; then
        check_fail "could not start the scratch server: $(first_line "$T/server.err")"
        return 1
    fi
    PANE=$(first_pane)
    if [ -z "$PANE" ]; then
        check_fail "session $SESSION has no pane"
        return 1
    fi
    SERVER_UP=1
    check_pass
}

step_tap_start() {
    local pipe
    check_begin tap-start-attaches
    need_server || return 0
    run_child tap-start "$BIN_DIR/tmux-share-tap-start"
    pipe=$(pane_pipe "$PANE")
    if [ "$RC" -ne 0 ]; then
        check_fail "tap-start exited $RC: $(first_line "$T/tap-start.out")"
    fi
    if [ "$pipe" != 1 ]; then
        check_fail "pane_pipe is $pipe after tap-start, expected 1"
    fi
    check_pass
}

# The stamp process for a pipe is new, so its first chunk carries a timestamp.
# That makes the marker line timestamped without waiting for an idle gap.
step_output() {
    local tok="SELFTEST-$$-output"
    check_begin output-reaches-transcript
    need_server || return 0
    if ! send_marker "$tok"; then
        check_fail 'send-keys to the pane failed'
        return 0
    fi
    if ! wait_for_marker "$tok"; then
        check_fail "no timestamped line with $tok in $LOG within 5 s"
    fi
    check_pass
}

step_watchdog() {
    local rc1 rc2 pipe
    check_begin watchdog-idempotent
    need_server || return 0
    run_child watchdog-1 "$BIN_DIR/tmux-share-watchdog"
    rc1=$RC
    run_child watchdog-2 "$BIN_DIR/tmux-share-watchdog"
    rc2=$RC
    if [ "$rc1" -ne 0 ]; then
        check_fail "first pass exited $rc1: $(first_line "$T/watchdog-1.out")"
    fi
    if [ "$rc2" -ne 0 ]; then
        check_fail "second pass exited $rc2: $(first_line "$T/watchdog-2.out")"
    fi
    pipe=$(pane_pipe "$PANE")
    if [ "$pipe" != 1 ]; then
        check_fail "pane_pipe is $pipe after the second pass, expected 1"
    fi
    check_pass
}

# ---- 3. deletion recovery --------------------------------------------------
step_deletion() {
    local rc pipe tok="SELFTEST-$$-rebuild"
    check_begin deletion-recovery
    need_server || return 0
    rm -f -- "$LOG" "$SEEN"
    # The wrapper records whether the rebuild marker exists while the pass
    # runs, then hands every call to the real tmux.
    printf '#!/usr/bin/env bash\n[ -e %q ] && : > %q\nexec %q "$@"\n' \
        "$REBUILD" "$SEEN" "$TMUX_BIN" > "$WRAP"
    chmod 0755 -- "$WRAP"
    run_child watchdog-rebuild env TMUX_SHARE_TMUX="$WRAP" "$BIN_DIR/tmux-share-watchdog"
    rc=$RC
    if [ "$rc" -ne 0 ]; then
        check_fail "rebuild pass exited $rc: $(first_line "$T/watchdog-rebuild.out")"
    fi
    if [ ! -e "$SEEN" ]; then
        check_fail "the rebuild marker $REBUILD was not present during the pass"
    fi
    if [ -e "$REBUILD" ]; then
        check_fail "the rebuild marker $REBUILD is still present after the pass"
    fi
    pipe=$(pane_pipe "$PANE")
    if [ "$pipe" != 1 ]; then
        check_fail "pane_pipe is $pipe after the rebuild, expected 1"
    fi
    if ! send_marker "$tok" || ! wait_for_marker "$tok"; then
        check_fail "no timestamped line with $tok in the rebuilt transcript within 5 s"
    fi
    check_pass
}

# ---- 4. trimming -----------------------------------------------------------
step_trim() {
    local size pipe tok="SELFTEST-$$-trim"
    check_begin trimming
    need_server || return 0
    # A fixture four times the bound, ending in a marker that must survive.
    head -c $((MAX_BYTES * 4)) /dev/zero | tr '\0' 'x' > "$LOG"
    printf '\nTAIL-%s\n' "$$" >> "$LOG"
    run_child trim "$BIN_DIR/tmux-share-trim"
    if [ "$RC" -ne 0 ]; then
        check_fail "trim exited $RC: $(first_line "$T/trim.out")"
    fi
    size=$(stat -c %s -- "$LOG" 2>/dev/null) || size=-1
    if [ "$size" -lt 0 ] || [ "$size" -gt "$MAX_BYTES" ]; then
        check_fail "transcript is $size bytes after trim, bound is $MAX_BYTES"
    fi
    if ! grep -aq "TAIL-$$" "$LOG" 2>/dev/null; then
        check_fail 'the newest bytes did not survive the trim'
    fi
    pipe=$(pane_pipe "$PANE")
    if [ "$pipe" != 1 ]; then
        check_fail "pane_pipe is $pipe after the trim, expected 1 (taps not re-attached)"
    fi
    if ! send_marker "$tok" || ! wait_for_marker "$tok"; then
        check_fail "no timestamped line with $tok in the trimmed transcript within 5 s"
    fi
    check_pass
}

# ---- 5. verifier -----------------------------------------------------------
step_verifier() {
    local failed
    check_begin verifier-clean
    need_server || return 0
    mkdir -p -- "$T/deploy-bin" "$T/units"
    cp -- "$BIN_DIR/tmux-share-tap-start" "$BIN_DIR/tmux-share-watchdog" \
        "$BIN_DIR/tmux-share-trim" "$T/deploy-bin/"
    run_child verify env \
        TMUX_SHARE_BINDIR="$T/deploy-bin" \
        TMUX_SHARE_UNITDIR="$T/units" \
        TMUX_SHARE_GROUP="$GROUP" \
        TMUX_SHARE_VERIFY_OWNER="$OWNER" \
        "$BIN_DIR/tmux-share-verify"
    if [ "$RC" -ne 0 ]; then
        check_fail "verifier exited $RC"
    fi
    failed=$(grep '^FAIL ' "$T/verify.out" || true)
    if [ -n "$failed" ]; then
        check_fail "verifier reported: $(printf '%s' "$failed" | tr '\n' ';')"
    fi
    if ! grep -q '^SKIP reader-cannot-connect-socket: ' "$T/verify.out"; then
        check_fail 'the verifier did not report its reader check as SKIP'
    fi
    check_pass
}

# ---- 6. teardown (always runs) ---------------------------------------------
step_teardown() {
    local left pid i
    kill_server
    check_begin cleanup-no-leftover-process
    if [ -z "$SOCK" ]; then
        check_pass
    else
        left=''
        i=0
        while :; do
            left=$(socket_procs)
            [ -n "$left" ] || break
            i=$((i + 1))
            [ "$i" -lt 30 ] || break
            sleep 0.1
        done
        if [ -z "$left" ]; then
            check_pass
        else
            check_fail "still running, command line names $SOCK: $(printf '%s' "$left" | tr '\n' ' ')"
            for pid in $left; do
                kill -TERM "$pid" 2>/dev/null || true
            done
        fi
    fi
    if [ "$KEEP" -eq 0 ]; then
        check_begin cleanup-temp-dir-removed
        if [ -n "$T" ]; then
            rm -rf -- "$T"
        fi
        if [ -z "$T" ] || [ ! -e "$T" ]; then
            check_pass
        else
            check_fail "$T still exists"
        fi
    fi
}

# on_exit: runs on every exit. After a normal finish it does nothing; after an
# abort (a signal, or an unexpected error) it does the same cleanup silently.
on_exit() {
    local rc=$? pid
    trap - EXIT
    if [ "$FINISHED" -eq 0 ]; then
        kill_server
        if [ -n "$SOCK" ]; then
            for pid in $(socket_procs); do
                kill -TERM "$pid" 2>/dev/null || true
            done
        fi
        if [ "$KEEP" -eq 0 ] && [ -n "$T" ]; then
            rm -rf -- "$T"
        fi
        check_summary || true
        printf 'SELFTEST: failed (the run was aborted)\n'
        if [ "$rc" -eq 0 ]; then
            rc=1
        fi
    fi
    exit "$rc"
}

trap on_exit EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

main() {
    if step_deps && step_tempdir; then
        set_child_env
        step_server
        step_tap_start
        step_output
        step_watchdog
        step_deletion
        step_trim
        step_verifier
    fi
    step_teardown
    FINISHED=1
    local status=0
    check_summary || status=1
    if [ "$KEEP" -eq 1 ] && [ -n "$T" ]; then
        printf 'kept temp dir: %s\n' "$T"
    fi
    if [ "$status" -eq 0 ]; then
        printf 'SELFTEST: ok\n'
    else
        printf 'SELFTEST: failed\n'
    fi
    exit "$status"
}

main
